variable "managed_keys" {
  description = <<EOT
Map of managed_keys, attributes below
Optional:
    - namespace
    - aws (block):
        - access_key (required)
        - allow_generate_key (optional)
        - allow_replace_key (optional)
        - allow_store_key (optional)
        - any_mount (optional)
        - curve (optional)
        - endpoint (optional)
        - key_bits (required)
        - key_type (required)
        - kms_key (required)
        - name (required)
        - region (optional)
        - secret_key (required)
        - usages (optional)
    - azure (block):
        - allow_generate_key (optional)
        - allow_replace_key (optional)
        - allow_store_key (optional)
        - any_mount (optional)
        - client_id (required)
        - client_secret (required)
        - environment (optional)
        - key_bits (optional)
        - key_name (required)
        - key_type (required)
        - name (required)
        - resource (optional)
        - tenant_id (required)
        - usages (optional)
        - vault_name (required)
    - gcp (block):
        - algorithm (required)
        - allow_generate_key (optional)
        - allow_replace_key (optional)
        - allow_store_key (optional)
        - any_mount (optional)
        - credentials (required)
        - crypto_key (required)
        - crypto_key_version (optional)
        - key_ring (required)
        - name (required)
        - project (required)
        - region (required)
        - usages (optional)
    - pkcs (block):
        - allow_generate_key (optional)
        - allow_replace_key (optional)
        - allow_store_key (optional)
        - any_mount (optional)
        - curve (optional)
        - force_rw_session (optional)
        - key_bits (optional)
        - key_id (optional)
        - key_label (optional)
        - library (required)
        - max_parallel (optional)
        - mechanism (required)
        - name (required)
        - pin (required)
        - slot (optional)
        - token_label (optional)
        - usages (optional)
EOT

  type = map(object({
    namespace = optional(string)
    aws = optional(list(object({
      access_key         = string
      allow_generate_key = optional(bool)
      allow_replace_key  = optional(bool)
      allow_store_key    = optional(bool)
      any_mount          = optional(bool)
      curve              = optional(string)
      endpoint           = optional(string)
      key_bits           = string
      key_type           = string
      kms_key            = string
      name               = string
      region             = optional(string)
      secret_key         = string
      usages             = optional(set(string))
    })))
    azure = optional(list(object({
      allow_generate_key = optional(bool)
      allow_replace_key  = optional(bool)
      allow_store_key    = optional(bool)
      any_mount          = optional(bool)
      client_id          = string
      client_secret      = string
      environment        = optional(string)
      key_bits           = optional(string)
      key_name           = string
      key_type           = string
      name               = string
      resource           = optional(string)
      tenant_id          = string
      usages             = optional(set(string))
      vault_name         = string
    })))
    gcp = optional(list(object({
      algorithm          = string
      allow_generate_key = optional(bool)
      allow_replace_key  = optional(bool)
      allow_store_key    = optional(bool)
      any_mount          = optional(bool)
      credentials        = string
      crypto_key         = string
      crypto_key_version = optional(string)
      key_ring           = string
      name               = string
      project            = string
      region             = string
      usages             = optional(set(string))
    })))
    pkcs = optional(list(object({
      allow_generate_key = optional(bool)
      allow_replace_key  = optional(bool)
      allow_store_key    = optional(bool)
      any_mount          = optional(bool)
      curve              = optional(string)
      force_rw_session   = optional(string)
      key_bits           = optional(string)
      key_id             = optional(string)
      key_label          = optional(string)
      library            = string
      max_parallel       = optional(number)
      mechanism          = string
      name               = string
      pin                = string
      slot               = optional(string)
      token_label        = optional(string)
      usages             = optional(set(string))
    })))
  }))
}

